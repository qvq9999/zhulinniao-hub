{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "竹林鸟朱雀 Hub",
  "version": "1.0.0",
  "identifier": "com.zhulinniao.hub",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "竹林鸟朱雀 Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebView2EnableDraggableRegions --no-sandbox --remote-debugging-port=9222 --remote-allow-origins=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/driver/base/CM002X1.Inf": "driver/base/CM002X1.Inf",
      "resources/driver/base/CM002X1.cat": "driver/base/CM002X1.cat",
      "resources/driver/base/x64/CM002X1.SYS": "driver/base/x64/CM002X1.SYS",
      "resources/driver/base/x64/CEB122D4.crt": "driver/base/x64/CEB122D4.crt",
      "resources/driver/apo/CM002X1_APO.inf": "driver/apo/CM002X1_APO.inf",
      "resources/driver/apo/CMApo.cat": "driver/apo/CMApo.cat",
      "resources/driver/apo/CmApoIce.dll": "driver/apo/CmApoIce.dll",
      "resources/driver/ext/CM002X1_Ext.inf": "driver/ext/CM002X1_Ext.inf",
      "resources/driver/ext/CMExt.cat": "driver/ext/CMExt.cat"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
