{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zhulinniao-hub/schemas/led-color-array-config.schema.json",
  "title": "LEDColorArrayConfig (legacy UI/Configs/LEDColorArrayConfig.json)",
  "type": "object",
  "required": ["ColorArray"],
  "properties": {
    "ColorArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    }
  },
  "additionalProperties": false
}
