Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %ProviderName%
ExtensionId = {BB9F401E-773C-4662-B338-E678F5AE2FCC}
CatalogFile = CMExt.cat
DriverVer 	=03/05/2026,1.0.0.18
PnpLockDown = 1

[Manufacturer]
%MfgName% = DeviceExtensions,NTamd64.10.0...17763,NTamd64.10.0...22000

[DeviceExtensions.NTamd64.10.0...17763]
%DeviceDesc.CMExt% = CMExt_Install,USB\VID_0D8C&PID_0334&MI_00
%DeviceDesc.CMExt% = CMExt_Install,USB\VID_4C4A&PID_4255&MI_00
%DeviceDesc.CMExt% = CMExt_Install,USB\VID_20F8&PID_A962&MI_00
%DeviceDesc.CMExt% = CMExt_Install,USB\VID_20F8&PID_A963&MI_00
